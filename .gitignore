# Raw dataset -- large, downloaded from HCRL. See data/README.md for the link.
data/raw/

# Everything under data/processed/ is derived from data/raw/ and is
# regenerable, so none of it is versioned:
#   *.npz            written by `python -m securecan.parse`
#   splits/          cached feature matrices (~450 MB) from the old v1 pipeline
#   constants.json   a stale v1 duplicate -- the live one is results/constants.json,
#                    which is what train.py writes and everything else reads
data/processed/

# Cached test-split predictions, written by evaluate.py so the comparison
# plots can be redrawn without re-running inference. ~136 MB, and derived
# entirely from the committed model plus the capture, so not worth versioning.
results/_*.npy

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Firmware build output
firmware/esp32/.pio/
*.elf
*.bin
*.o
*.exe

