# Raw dataset -- large, downloaded from HCRL. See data/README.md for the link.
data/raw/

# Processed arrays -- regenerate with `python -m securecan.parse`
data/processed/*.npz
data/processed/*.csv

# Cached test-split predictions, written by evaluate.py so the comparison
# plots can be redrawn without re-running inference. ~136 MB, and derived
# entirely from the committed model plus the capture, so not worth versioning.
results/_*.npy

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Firmware build output
firmware/esp32/.pio/
*.elf
*.bin
*.o
*.exe

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Claude Code local state
.claude/
